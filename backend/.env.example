# Public browser configuration only. Safe to expose when using Supabase RLS.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# Server-side secrets: set these in Supabase Edge Function secrets, NOT in this file,
# GitHub, browser JavaScript, or a public repository.
# SUPABASE_SERVICE_ROLE_KEY=
# PAYFAST_MERCHANT_ID=
# PAYFAST_MERCHANT_KEY=
# PAYFAST_PASSPHRASE=
# PAYFAST_SANDBOX=true
